<?xml version="1.0"?>
<package format="3">
  <name>pcl_filter_msgs</name>
  <version>0.1.0</version>
  <description>Messages for color/shape filtering (ROS 2)</description>

  <maintainer email="sixerwyj@gmail.com">Yijia Wu</maintainer>
  <author email="sixerwyj@gmail.com">Yijia Wu</author>
  <license>GPL-3.0-or-later</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- rosidl (generate .msg) -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Mark as an interface package -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

